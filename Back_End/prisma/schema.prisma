generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums para Incidente
enum TipoIncidente {
  PREVENTIVA
  CORRETIVA
  PLANEJADA
}

enum StatusIncidente {
  EM_ABERTO
  CONCLUIDO
}

enum MachineNameEnum {
  RTX5090
  R75800X3D
  SSDSATA
  SSDNVME
  RAMDDR43200MHZ
}

enum SeverityEnum {
  BAIXA 
  MEDIA 
  ALTA
}

model Incidente {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  description       String
  typeOfOccurrence  TipoIncidente     @default(PREVENTIVA)
  machineName       MachineNameEnum
  status            StatusIncidente   @default(EM_ABERTO)
  severity          SeverityEnum      @default(BAIXA)
  createdAt         DateTime          @default(now())
  finishedAt        DateTime?
}
