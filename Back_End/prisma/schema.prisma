generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums para Incidente
enum TipoIncidente {
  PREVENTIVA
  CORRETIVA
  PLANEJADA
}

enum StatusIncidente {
  EM_ABERTO
  CONCLUIDO
}

enum SetorMachine {
  PRODUCAO
  USINAGEM
  TELHAGEM
}

enum SeverityEnum {
  BAIXA 
  MEDIA 
  ALTA
}

model Machine {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String       @unique
  setor     SetorMachine
  status    Boolean      @default(true)
  incidentes Incidente[]
}

model Incidente {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  description       String
  typeOfOccurrence  TipoIncidente     @default(PREVENTIVA)
  machineId         String            @db.ObjectId
  machine           Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  status            StatusIncidente   @default(EM_ABERTO)
  severity          SeverityEnum      @default(BAIXA)
  createdAt         DateTime          @default(now())
  finishedAt        DateTime?
}
